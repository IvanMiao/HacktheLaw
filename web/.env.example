MISTRAL_API_KEY=
# Optional server-only intent model; never use a VITE_ secret.
MISTRAL_INTENT_MODEL=ministral-8b-latest
# Optional extra browser origins, comma-separated.
VOICE_ALLOWED_ORIGINS=

# Server-only law-firm REST token. Unset => /api/v1 fails closed.
DOMINO_INTEGRATION_KEY=
# Optional explicit synthetic SQLite bridge file and allowed matter IDs.
DOMINO_SQLITE_FILE=
DOMINO_SQLITE_MATTERS=demo-c1-c2
# Local UI bridge is disabled by default; dev:integrations enables loopback only.
DOMINO_LOCAL_CONNECTIONS=false
DOMINO_UI_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
# Optional server-only JSON AI profiles; see docs/LAW_FIRM_INTEGRATION.md.
# DOMINO_AI_PROFILES=[{"id":"firm-ai","label":"Firm API","protocol":"openai-compatible-chat","model":"firm-model","baseUrl":"http://127.0.0.1:9911/v1","credentialEnv":"FIRM_AI_API_KEY","trustedOrigins":["http://127.0.0.1:9911"]}]
FIRM_AI_API_KEY=
